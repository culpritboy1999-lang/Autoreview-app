# ── Server ──────────────────────────────────────────────────────
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string

# ── AI engine (best free models — add ONE of these keys) ────────
# 1) OpenRouter — google/gemma-3-27b-it:free  (https://openrouter.ai/keys)
#OPENROUTER_API_KEY=
#OPENROUTER_MODEL=google/gemma-3-27b-it:free
# 2) Groq free tier — gemma2-9b-it            (https://console.groq.com/keys)
#GROQ_API_KEY=
#GROQ_MODEL=gemma2-9b-it
# 3) Google AI Studio free tier — gemini-2.0-flash (https://aistudio.google.com/apikey)
#GOOGLE_AI_API_KEY=
#GOOGLE_AI_MODEL=gemini-2.0-flash
# With no key, the built-in brand-rules engine writes replies (offline fallback).

# ── Google OAuth (shop owner login + Business Profile connect) ──
# Create an OAuth "Web application" client in Google Cloud Console,
# enable "Business Profile API" + "My Business Account Management API",
# and register these redirect URIs on the client:
#   https://<your-host>/auth/google/callback
#   https://<your-host>/dashboard/connect/google/callback
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# ── Google Places API (New) — public guest shop search ──────────
#PLACES_API_KEY=

# ── Worker ──────────────────────────────────────────────────────
SYNC_INTERVAL_MS=90000
